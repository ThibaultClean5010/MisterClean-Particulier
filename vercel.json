{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": false,
  "functions": {
    "api/**/*.ts": {
      "regions": ["syd1"]
    }
  },
  "rewrites": [
    { "source": "/api/admin/auth/logout", "destination": "/api/admin/auth/session" }
  ],
  "crons": [
    {
      "path": "/api/cron/send-booking-emails",
      "schedule": "0 0 * * *"
    }
  ]
}
