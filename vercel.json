{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": false,
  "functions": {
    "api/**/*.ts": {
      "regions": ["syd1"]
    }
  },
  "crons": [
    {
      "path": "/api/cron/send-booking-emails",
      "schedule": "0 0 * * *"
    }
  ]
}
